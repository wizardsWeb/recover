SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-settings
LOG_LEVEL=INFO
ENVIRONMENT=local
VERSION=0.1.0
ALLOWED_ORIGINS=http://localhost:3000

# Google AI Studio key for the Phase 5 Gemini calls (diagnose, message, listen).
# Optional: without it every LLM step returns its fallback and the loop still runs.
GEMINI_API_KEY=AIza...

# Optional. Carries the Gemini rate limiter (12 req/min token bucket) and the
# network alert fan-out that the /app/network WebSocket subscribes to.
# Unset falls back to an in-process fakeredis: correct on one laptop, wrong
# anywhere with more than one worker, because pub/sub then reaches only
# subscribers inside the same process. Production sets this.
# REDIS_URL=redis://localhost:6379

# Background cross-merchant network poller: aggregate, detect, resolve.
# NETWORK_POLLER_ENABLED=true
# NETWORK_POLL_INTERVAL_SECONDS=60

# ── Razorpay ─────────────────────────────────────────────────────────────
# Test keys from dashboard.razorpay.com → Settings → API Keys (Test mode).
# Leave all of these empty and the execution adapters simulate instead: the
# product works end to end with no Razorpay account.
RAZORPAY_TEST_API_KEY=
RAZORPAY_TEST_KEY_SECRET=

# The signing secret you set on the webhook in Settings → Webhooks. Inbound
# calls carrying X-Razorpay-Signature are rejected unless they verify against
# this; calls without the header (the simulator) are unaffected.
RAZORPAY_WEBHOOK_SECRET=

# Which merchant a signature-verified webhook belongs to when its customer is
# not one we already know. A real Razorpay webhook carries no bearer token, so
# there is no JWT to read the merchant from.
RAZORPAY_WEBHOOK_MERCHANT_ID=

# The real test-mode subscription and customer that scenario S1 fires against,
# created by hand in the Razorpay dashboard (Plans -> Customers -> Subscriptions).
# Leave empty and S1 uses the scripted fixture ids, which is what keeps all six
# scenarios runnable with no Razorpay account. Set them and S1 becomes real: the
# subscription adapter reads a live subscription and a real subscription.charged
# webhook can be matched back to the case it settled.
#
# The customer id must be the one on the Razorpay customer, because that string
# is what the webhook receiver looks a settlement up by.
RAZORPAY_DEMO_SUBSCRIPTION_ID=
RAZORPAY_DEMO_CUSTOMER_ID=
