SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-settings
LOG_LEVEL=INFO
ENVIRONMENT=local
VERSION=0.1.0
ALLOWED_ORIGINS=http://localhost:3000

# Google AI Studio key for the Phase 5 Gemini calls (diagnose, message, listen).
# Optional: without it every LLM step returns its fallback and the loop still runs.
GEMINI_API_KEY=AIza...

# Optional. Enables the Gemini rate limiter (12 req/min token bucket).
# Unset means no limiter at all, which is the right default locally.
# REDIS_URL=redis://localhost:6379
