# Shared reference for both apps. Copy the relevant block into
# frontend/.env.local and backend/.env — neither app reads this file directly.

# ---------- Supabase (Project Settings -> API) ----------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key
# Project Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret

# ---------- Frontend (must be NEXT_PUBLIC_ to reach the browser) ----------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENVIRONMENT=local

# ---------- Backend ----------
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
ENVIRONMENT=local
VERSION=0.1.0

# ---------- Redis (Phase 6+, unused so far) ----------
REDIS_URL=redis://localhost:6379

# ---------- LLM (Phase 5+, unused so far) ----------
GEMINI_API_KEY=

# Deployed values do not live here. On Azure the backend reads its secrets from
# Key Vault, and the frontend's NEXT_PUBLIC_* values are build args supplied by
# GitHub Actions — see infra/README.md.
