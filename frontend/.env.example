# Copy to .env.local for `npm run dev`.
# For `docker compose up`, fill the root .env instead — the NEXT_PUBLIC_ values
# are build args there, because Next inlines them into the bundle at build time.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# local | local-prod | staging | production. Gates the dev tools in the sidebar
# and the deployment label in the header.
NEXT_PUBLIC_ENVIRONMENT=local
